<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="MonitorLotacaoApp.Views.LoginPage"
             Title="Acesso ao Sistema"
             BackgroundColor="#2D3238">

    <ScrollView>
        <VerticalStackLayout Padding="30" Spacing="20" VerticalOptions="Center">

            <!-- Título do Aplicativo -->
            <Label Text="Monitor de Lotação"
                   FontSize="26"
                   FontAttributes="Bold"
                   TextColor="White"
                   HorizontalTextAlignment="Center" />

            <Label Text="Faça login ou cadastre-se para colaborar"
                   FontSize="13"
                   TextColor="#90A4AE"
                   HorizontalTextAlignment="Center"
                   Margin="0,0,0,20" />

            <!-- Campo E-mail -->
            <Entry x:Name="TxtEmail"
                   Placeholder="E-mail institucional ou pessoal"
                   PlaceholderColor="#90A4AE"
                   TextColor="White"
                   BackgroundColor="#37474F"
                   Keyboard="Email"
                   HeightRequest="50" />

            <!-- Campo Senha -->
            <Entry x:Name="TxtSenha"
                   Placeholder="Senha de acesso"
                   PlaceholderColor="#90A4AE"
                   TextColor="White"
                   BackgroundColor="#37474F"
                   IsPassword="True"
                   HeightRequest="50" />

            <!-- Botão de Esqueci a Senha / Redefinir -->
            <Button Text="Esqueci minha senha?"
                    BackgroundColor="Transparent"
                    TextColor="#90CAF9"
                    FontSize="13"
                    HorizontalOptions="End"
                    Padding="0"
                    Margin="0,-10,0,5"
                    Clicked="OnRedefinirSenhaClicked" />

            <!-- Botão Entrar -->
            <Button Text="Entrar"
                    BackgroundColor="#1976D2"
                    TextColor="White"
                    FontSize="16"
                    FontAttributes="Bold"
                    HeightRequest="55"
                    CornerRadius="10"
                    Clicked="OnEntrarClicked" />

            <!-- Divisor visual -->
            <BoxView HeightRequest="1" Color="#455A64" Margin="0,10" />

            <!-- Texto auxiliar para novos usuários -->
            <Label Text="Ainda não tem uma conta?"
                   FontSize="13"
                   TextColor="#B0BEC5"
                   HorizontalTextAlignment="Center" />

            <!-- Botão Cadastrar Nova Conta (Aponta para OnIrParaCadastroClicked) -->
            <Button Text="Cadastrar Nova Conta"
                    BackgroundColor="#2E7D32"
                    TextColor="White"
                    FontSize="16"
                    FontAttributes="Bold"
                    HeightRequest="55"
                    CornerRadius="10"
                    Clicked="OnIrParaCadastroClicked" />

        </VerticalStackLayout>
    </ScrollView>
</ContentPage>