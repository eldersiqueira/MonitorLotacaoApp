<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:MonitorLotacaoApp.ViewModels"
             x:Class="MonitorLotacaoApp.Views.SelecaoLinhaPage"
             Title="Seleção de Linha"
             BackgroundColor="#F5F5F5">

    <ContentPage.BindingContext>
        <vm:SelecaoLinhaViewModel />
    </ContentPage.BindingContext>

    <VerticalStackLayout Spacing="20" Padding="20">

        <Label Text="Escolha a sua linha de ônibus:" 
               FontSize="20" 
               FontAttributes="Bold" 
               TextColor="#1e81b0" 
               HorizontalOptions="Center"
               Margin="0,10,0,10"/>

        <!-- Lista de Linhas Disponíveis -->
        <CollectionView ItemsSource="{Binding LinhasDeOnibus}"
                        HeightRequest="400">
            <CollectionView.ItemTemplate>
                <DataTemplate>
                    <Frame Margin="0,5" Padding="15" BackgroundColor="White" CornerRadius="8">
                        <VerticalStackLayout>
                            <Label Text="{Binding NumeroENome}" 
                                   FontAttributes="Bold" 
                                   FontSize="16" 
                                   TextColor="#333333"/>
                            <Label Text="{Binding Destino}" 
                                   FontSize="14" 
                                   TextColor="#666666"/>

                            <!-- Botão para avançar para o relato desta linha específica -->
                            <Button Text="Selecionar esta Linha" 
                                    Command="{Binding Source={RelativeSource AncestorType={x:Type vm:SelecaoLinhaViewModel}}, Path=SelecionarLinhaCommand}"
                                    CommandParameter="{Binding .}"
                                    BackgroundColor="#1e81b0" 
                                    TextColor="White" 
                                    FontSize="12"
                                    HeightRequest="40"
                                    Margin="0,10,0,0"/>
                        </VerticalStackLayout>
                    </Frame>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>

        <!-- Indicador de Carregamento -->
        <ActivityIndicator IsRunning="{Binding IsBusy}" 
                           IsVisible="{Binding IsBusy}" 
                           Color="#1e81b0" 
                           HorizontalOptions="Center" />

    </VerticalStackLayout>
</ContentPage>