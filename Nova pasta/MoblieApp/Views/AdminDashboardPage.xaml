<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="MonitorLotacaoApp.Views.AdminDashboardPage"
             Title="Painel do Administrador - Gestão"
             BackgroundColor="#1E293B">

    <ScrollView>
        <VerticalStackLayout Padding="25" Spacing="15" VerticalOptions="Center">

            <!-- Título do Painel -->
            <Label Text="Painel do Gestor de Frotas"
                   FontSize="26"
                   FontAttributes="Bold"
                   HorizontalOptions="Center"
                   TextColor="#38BDF8" />

            <Label Text="Gerencie frotas, relatórios e acessos do sistema"
                   FontSize="14"
                   HorizontalOptions="Center"
                   TextColor="#94A3B8"
                   Margin="0,0,0,15"/>

            <!-- Botão 1: Visualizar Relatórios de Eficiência -->
            <Button Text="📊 Visualizar Relatórios de Eficiência"
                    FontSize="15"
                    FontAttributes="Bold"
                    BackgroundColor="#0284C7"
                    TextColor="White"
                    CornerRadius="8"
                    HeightRequest="50"
                    Clicked="OnVerRelatoriosClicked" />

            <!-- Botão 2: Identificar Horários Críticos -->
            <Button Text="⏰ Identificar Horários Críticos"
                    FontSize="15"
                    FontAttributes="Bold"
                    BackgroundColor="#DC2626"
                    TextColor="White"
                    CornerRadius="8"
                    HeightRequest="50"
                    Clicked="OnHorariosCriticosClicked" />

            <!-- Botão 3: Gerenciar Frotas e Linhas -->
            <Button Text="🚌 Gerenciar Frotas e Linhas"
                    FontSize="15"
                    FontAttributes="Bold"
                    BackgroundColor="#D97706"
                    TextColor="White"
                    CornerRadius="8"
                    HeightRequest="50"
                    Clicked="OnGerenciarFrotaClicked" />

            <!-- Botão 4: Exportar Relatórios -->
            <Button Text="📁 Exportar Relatórios (CSV/PDF)"
                    FontSize="15"
                    FontAttributes="Bold"
                    BackgroundColor="#059669"
                    TextColor="White"
                    CornerRadius="8"
                    HeightRequest="50"
                    Clicked="OnExportarRelatoriosClicked" />

            <!-- Novo Botão: Gestão de Acessos de Perfis -->
            <Button Text="👥 Gestão de Acessos de Perfis"
                    FontSize="15"
                    FontAttributes="Bold"
                    BackgroundColor="#4F46E5"
                    TextColor="White"
                    CornerRadius="8"
                    HeightRequest="50"
                    Clicked="OnGerenciarAcessosClicked" />

        </VerticalStackLayout>
    </ScrollView>
</ContentPage>