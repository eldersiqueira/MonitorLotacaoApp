<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="MonitorLotacaoApp.MainPage"
             Title="Monitor de Lotação"
             BackgroundColor="#F4F6F9">

    <Grid RowDefinitions="*, Auto" Padding="24">

        <!-- Conteúdo Direcionado aos Passageiros (Core do TCC) -->
        <VerticalStackLayout Grid.Row="0" VerticalOptions="Center" Spacing="20">
            <Label Text="Transporte Inteligente" 
                   FontSize="26" 
                   FontAttributes="Bold" 
                   TextColor="#2C3E50" 
                   HorizontalOptions="Center"/>

            <Label Text="Colabore informando a lotação do seu autocarro em tempo real para melhorar a mobilidade urbana." 
                   FontSize="14" 
                   TextColor="#7F8C8D" 
                   HorizontalTextAlignment="Center"/>

            <!-- Botão principal do Passageiro (Ex: Ir para o mapa ou relatar) -->
            <Button Text="Reportar Lotação Agora" 
                    BackgroundColor="#27AE60" 
                    TextColor="White" 
                    CornerRadius="10" 
                    HeightRequest="50"
                    FontAttributes="Bold"/>
        </VerticalStackLayout>

        <!-- Botão Discreto de Acesso Restrito (Rodapé) -->
        <Button Grid.Row="1" 
                Text="🔒 Acesso Restrito (Administrador)" 
                BackgroundColor="Transparent" 
                TextColor="#95A5A6" 
                FontSize="12" 
                HorizontalOptions="Center"
                Clicked="OnIrParaLoginAdminClicked"/>
    </Grid>
</ContentPage>