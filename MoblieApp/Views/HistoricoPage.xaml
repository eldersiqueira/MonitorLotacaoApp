<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="MonitorLotacaoApp.Views.HistoricoPage"
             Title="Histórico e Indicadores de Lotação">

    <VerticalStackLayout Padding="20" Spacing="15">

        <!-- Cabeçalho descritivo da tela -->
        <Label Text="Evolução e Histórico de Ocupação"
               FontSize="22"
               FontAttributes="Bold"
               HorizontalOptions="Center" />

        <!-- Correção aplicada: uso de HorizontalTextAlignment em vez de TextAlign -->
        <Label Text="Acompanhe abaixo os últimos registros de lotação reportados para a linha selecionada:"
               FontSize="14"
               TextColor="Gray"
               HorizontalOptions="Center"
               HorizontalTextAlignment="Center" />

        <!-- Lista de Exibição dos Dados Históricos (CollectionView) -->
        <CollectionView x:Name="CollectionHistorico" HeightRequest="400">
            <CollectionView.ItemTemplate>
                <DataTemplate>
                    <Frame Margin="0,5" Padding="15" CornerRadius="8" HasShadow="True">
                        <Grid ColumnDefinitions="*, Auto" RowDefinitions="Auto, Auto">

                            <!-- Nível de Lotação -->
                            <Label Text="{Binding NivelLotacao}" 
                                   FontAttributes="Bold" 
                                   FontSize="16" 
                                   TextColor="#2c3e50" />

                            <!-- Horário do Relato -->
                            <Label Grid.Column="1" 
                                   Text="{Binding Horario}" 
                                   FontSize="12" 
                                   TextColor="Gray" 
                                   VerticalOptions="Center" />

                            <!-- Status de Sincronização -->
                            <Label Grid.Row="1" Grid.ColumnSpan="2" 
                                   Text="{Binding Status}" 
                                   FontSize="12" 
                                   TextColor="#27ae60" 
                                   Margin="0,5,0,0"/>
                        </Grid>
                    </Frame>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>

        <!-- Botão para Atualizar os Dados -->
        <Button Text="Atualizar Histórico"
                BackgroundColor="#3498db"
                TextColor="White"
                CornerRadius="8" />

    </VerticalStackLayout>
</ContentPage>