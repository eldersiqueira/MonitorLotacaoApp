<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="MonitorLotacaoApp.Views.SelecionarLinhaPage"
             Title="Selecionar Linha de Ônibus"
             BackgroundColor="#F5F6FA">

    <VerticalStackLayout Spacing="20" Padding="25">

        <Label Text="Escolha a sua linha"
               FontSize="22"
               FontAttributes="Bold"
               HorizontalOptions="Center"
               TextColor="#2C3E50"/>

        <Label Text="Selecione abaixo uma das 5 linhas monitoradas para prosseguir com o reporte de lotação:"
               FontSize="14"
               HorizontalOptions="Center"
               HorizontalTextAlignment="Center"
               TextColor="#7F8C8D"/>

        <!-- Lista de Linhas de Ônibus (Escopo do TCC) -->
        <CollectionView x:Name="CollectionLinhas" SelectionMode="Single" SelectionChanged="OnLinhaSelected">
            <CollectionView.ItemTemplate>
                <DataTemplate>
                    <!-- O Frame ou Border atua como a área sensível ao toque -->
                    <Border Stroke="#E0E0E0" StrokeThickness="1" StrokeShape="RoundRectangle 12" BackgroundColor="White" Padding="15" Margin="0,5">
                        <VerticalStackLayout Spacing="4">
                            <Label Text="{Binding NomeLinha}" FontSize="18" FontAttributes="Bold" TextColor="#0056b3"/>
                            <Label Text="{Binding Trajeto}" FontSize="13" TextColor="#666666"/>
                        </VerticalStackLayout>
                    </Border>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>

    </VerticalStackLayout>
</ContentPage>