<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="MonitorLotacaoApp.Views.LoginPage"
             Title="Autenticação">

    <ScrollView>
        <VerticalStackLayout Padding="30" Spacing="20" VerticalOptions="Center">

            <!-- Título Principal -->
            <Label Text="Monitor de Lotação"
                   FontSize="28"
                   FontAttributes="Bold"
                   HorizontalOptions="Center"
                   TextColor="#1b6ca8" />

            <Label Text="Faça login ou cadastre-se para continuar"
                   FontSize="14"
                   HorizontalOptions="Center"
                   TextColor="Gray"
                   Margin="0,0,0,20"/>

            <!-- Campos de Entrada -->
            <Entry x:Name="TxtNome"
                   Placeholder="Nome completo (apenas para cadastro)"
                   ClearButtonVisibility="WhileEditing" />

            <Entry x:Name="TxtEmail"
                   Placeholder="E-mail profissional ou pessoal"
                   Keyboard="Email"
                   ClearButtonVisibility="WhileEditing" />

            <Entry x:Name="TxtSenha"
                   Placeholder="Senha de acesso (mín. 6 caracteres)"
                   IsPassword="True"
                   ClearButtonVisibility="WhileEditing" />

            <!-- Botões de Ação -->
            <Button x:Name="BtnEntrar"
                    Text="Entrar"
                    BackgroundColor="#1b6ca8"
                    TextColor="White"
                    CornerRadius="8"
                    HeightRequest="50"
                    Clicked="OnEntrarClicked" />

            <Button x:Name="BtnCadastrar"
                    Text="Cadastrar Nova Conta"
                    BackgroundColor="#28a745"
                    TextColor="White"
                    CornerRadius="8"
                    HeightRequest="50"
                    Clicked="OnCadastrarClicked" />

            <!-- Botão do Tópico 1: Redefinição de Senha -->
            <Button x:Name="BtnRedefinir"
                    Text="Esqueci / Redefinir Senha"
                    BackgroundColor="#f0ad4e"
                    TextColor="White"
                    CornerRadius="8"
                    HeightRequest="45"
                    Clicked="OnRedefinirSenhaClicked" />

        </VerticalStackLayout>
    </ScrollView>
</ContentPage>