<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:MonitorLotacaoApp.ViewModels"
             x:Class="MonitorLotacaoApp.Views.LoginPage"
             Title="Autenticação"
             BackgroundColor="#F5F5F5">

    <ContentPage.BindingContext>
        <vm:LoginViewModel />
    </ContentPage.BindingContext>

    <ScrollView>
        <VerticalStackLayout Spacing="20" Padding="30" VerticalOptions="Center">

            <Label Text="Monitor de Lotação" 
                   FontSize="28" 
                   FontAttributes="Bold" 
                   HorizontalOptions="Center" 
                   TextColor="#1e81b0" 
                   Margin="0,0,0,20" />

            <Entry x:Name="EmailEntry"
                   Text="{Binding Email}"
                   Placeholder="Digite seu E-mail" 
                   Keyboard="Email" 
                   BackgroundColor="White"
                   ClearButtonVisibility="WhileEditing"/>

            <Entry x:Name="SenhaEntry"
                   Text="{Binding Senha}"
                   Placeholder="Digite sua Senha" 
                   IsPassword="True" 
                   BackgroundColor="White"
                   ClearButtonVisibility="WhileEditing"/>

            <!-- Agora ele olha direto para a propriedade TemErro no C# -->
            <Label Text="{Binding MensagemErro}" 
                   TextColor="Red" 
                   HorizontalOptions="Center" 
                   IsVisible="{Binding TemErro}" />

            <ActivityIndicator IsRunning="{Binding IsBusy}" 
                               IsVisible="{Binding IsBusy}" 
                               Color="#1e81b0" 
                               HorizontalOptions="Center" />

            <!-- O botão desativa automaticamente usando o IsNotBusy -->
            <Button Text="Entrar" 
                    Command="{Binding RealizarLoginCommand}" 
                    BackgroundColor="#1e81b0" 
                    TextColor="White" 
                    CornerRadius="8"
                    HeightRequest="50"
                    IsEnabled="{Binding IsNotBusy}" />

            <Button Text="Esqueci minha senha" 
                    Command="{Binding IrParaRedefinirSenhaCommand}" 
                    BackgroundColor="Transparent" 
                    TextColor="#1e81b0" 
                    FontAttributes="Bold" 
                    Margin="0,10,0,0"/>

        </VerticalStackLayout>
    </ScrollView>
</ContentPage>