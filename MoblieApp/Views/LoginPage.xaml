<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="MonitorLotacaoApp.Views.LoginPage"
             Title="Autenticação"
             BackgroundColor="#F5F5F5">

    <ScrollView>
        <VerticalStackLayout Spacing="20" Padding="30" VerticalOptions="Center">

            <Label Text="Monitor de Lotação" 
                   FontSize="28" 
                   FontAttributes="Bold" 
                   HorizontalOptions="Center" 
                   TextColor="#1e81b0" 
                   Margin="0,0,0,20" />

            <Entry x:Name="TxtNome"
                   Placeholder="Nome completo (apenas para cadastro)" 
                   BackgroundColor="White"
                   ClearButtonVisibility="WhileEditing"/>

            <Entry x:Name="TxtEmail"
                   Placeholder="E-mail profissional ou pessoal" 
                   Keyboard="Email" 
                   BackgroundColor="White"
                   ClearButtonVisibility="WhileEditing"/>

            <Entry x:Name="TxtSenha"
                   Placeholder="Senha de acesso (mín. 6 caracteres)" 
                   IsPassword="True" 
                   BackgroundColor="White"
                   ClearButtonVisibility="WhileEditing"/>

            <Button Text="Entrar" 
                    Clicked="OnEntrarClicked" 
                    BackgroundColor="#1e81b0" 
                    TextColor="White" 
                    CornerRadius="8"
                    HeightRequest="50" />

            <Button Text="Cadastrar Nova Conta" 
                    Clicked="OnCadastrarClicked" 
                    BackgroundColor="#28a745" 
                    TextColor="White" 
                    CornerRadius="8"
                    HeightRequest="50" />

        </VerticalStackLayout>
    </ScrollView>
</ContentPage>