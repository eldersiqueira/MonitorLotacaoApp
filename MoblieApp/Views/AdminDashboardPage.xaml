<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="MonitorLotacaoApp.Views.AdminDashboardPage"
             Title="Painel Administrativo - Gestão"
             BackgroundColor="#F5F5F5">

    <ScrollView>
        <VerticalStackLayout Spacing="20" Padding="25" VerticalOptions="Center">

            <Label Text="Painel do Gestor de Frotas" 
                   FontSize="26" 
                   FontAttributes="Bold" 
                   HorizontalOptions="Center" 
                   TextColor="#1e81b0" 
                   Margin="0,0,0,15"/>

            <!-- 1. Visualizar Relatórios de Eficiência -->
            <Button Text="📊 Visualizar Relatórios de Eficiência" 
                    Clicked="OnVerRelatoriosClicked" 
                    BackgroundColor="#1e81b0" 
                    TextColor="White" 
                    CornerRadius="8"
                    HeightRequest="55" />

            <!-- 2. Identificar Horários Críticos -->
            <Button Text="⏰ Identificar Horários Críticos" 
                    Clicked="OnHorariosCriticosClicked" 
                    BackgroundColor="#d9534f" 
                    TextColor="White" 
                    CornerRadius="8"
                    HeightRequest="55" />

            <!-- 3. Gerenciar Frotas e Linhas -->
            <Button Text="🚌 Gerenciar Frotas e Linhas" 
                    Clicked="OnGerenciarFrotaClicked" 
                    BackgroundColor="#f0ad4e" 
                    TextColor="White" 
                    CornerRadius="8"
                    HeightRequest="55" />

            <!-- Ação complementar: Exportar Relatórios -->
            <Button Text="📁 Exportar Relatórios (CSV/PDF)" 
                    Clicked="OnExportarRelatoriosClicked" 
                    BackgroundColor="#5cb85c" 
                    TextColor="White" 
                    CornerRadius="8"
                    HeightRequest="55" />

        </VerticalStackLayout>
    </ScrollView>
</ContentPage>