<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="MonitorLotacaoApp.Views.CadastroPage"
             Title="Criar Nova Conta"
             BackgroundColor="#F4F6F9">

    <VerticalStackLayout Padding="24" Spacing="16" VerticalOptions="Center">
        <Label Text="Registo de Passageiro" 
               FontSize="24" 
               FontAttributes="Bold" 
               TextColor="#2C3E50" 
               HorizontalOptions="Center"/>

        <Label Text="Preencha os dados abaixo para aceder ao sistema colaborativo." 
               FontSize="13" 
               TextColor="#7F8C8D" 
               HorizontalTextAlignment="Center"/>

        <Entry x:Name="TxtNome" Placeholder="Nome completo" />
        <Entry x:Name="TxtEmail" Placeholder="E-mail" Keyboard="Email" />
        <Entry x:Name="TxtSenha" Placeholder="Palavra-passe" IsPassword="True" />

        <Button Text="Registar Conta" 
                BackgroundColor="#27AE60" 
                TextColor="White" 
                CornerRadius="8" 
                HeightRequest="50"
                Clicked="OnSalvarCadastroClicked"/>
    </VerticalStackLayout>
</ContentPage>