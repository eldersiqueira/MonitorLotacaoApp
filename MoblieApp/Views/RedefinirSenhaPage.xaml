<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="MonitorLotacaoApp.Views.RedefinirSenhaPage"
             Title="Redefinir Senha"
             BackgroundColor="#F4F6F9">

    <VerticalStackLayout Padding="24" Spacing="16" VerticalOptions="Center">
        <Label Text="Recuperação de Acesso" FontSize="22" FontAttributes="Bold" TextColor="#2C3E50" HorizontalOptions="Center"/>
        <Label Text="Insira o seu e-mail registado e defina uma nova palavra-passe." FontSize="14" TextColor="#7F8C8D" HorizontalTextAlignment="Center"/>

        <Entry x:Name="TxtEmail" Placeholder="E-mail cadastrado" Keyboard="Email" />
        <Entry x:Name="TxtNovaSenha" Placeholder="Nova palavra-passe" IsPassword="True" />

        <Button Text="Atualizar Senha" BackgroundColor="#27ae60" TextColor="White" Clicked="OnRedefinirClicked" CornerRadius="8"/>
    </VerticalStackLayout>
</ContentPage>