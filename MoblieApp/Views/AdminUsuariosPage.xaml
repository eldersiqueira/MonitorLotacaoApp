<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="MonitorLotacaoApp.Views.AdminUsuariosPage"
             Title="Painel do Administrador"
             BackgroundColor="#F4F6F9">

    <Grid RowDefinitions="Auto, *" RowSpacing="12" Padding="16">

        <!-- Cabeçalho do Painel Administrativo -->
        <VerticalStackLayout Grid.Row="0" Spacing="4">
            <Label Text="Gestão de Utilizadores"
                   FontSize="22"
                   FontAttributes="Bold"
                   TextColor="#2C3E50" />
            <Label Text="Controlo e auditoria de cadastros do sistema de transporte."
                   FontSize="13"
                   TextColor="#7F8C8D" />
        </VerticalStackLayout>

        <!-- Lista de Utilizadores com Design em Cartões Modernos -->
        <CollectionView x:Name="CollectionUsuarios"
                        Grid.Row="1"
                        SelectionMode="None">
            <CollectionView.ItemTemplate>
                <DataTemplate>
                    <Frame Margin="0,6"
                           Padding="14"
                           CornerRadius="12"
                           HasShadow="True"
                           BackgroundColor="White"
                           BorderColor="#E1E8ED">

                        <Grid ColumnDefinitions="*, Auto" VerticalOptions="Center">
                            <!-- Informações do Utilizador -->
                            <VerticalStackLayout Grid.Column="0" Spacing="2">
                                <Label Text="{Binding nome}" 
                                       FontAttributes="Bold" 
                                       FontSize="16" 
                                       TextColor="#2C3E50" />
                                <Label Text="{Binding email}" 
                                       FontSize="13" 
                                       TextColor="#7F8C8D" />
                            </VerticalStackLayout>

                            <!-- Botão de Ação (Remover) -->
                            <Button Grid.Column="1"
                                    Text="Remover"
                                    BackgroundColor="#E74C3C"
                                    TextColor="White"
                                    FontSize="12"
                                    FontAttributes="Bold"
                                    CornerRadius="8"
                                    HeightRequest="36"
                                    Padding="12,0"
                                    CommandParameter="{Binding idPassageiro}"
                                    Clicked="OnRemoverUserClicked" />
                        </Grid>
                    </Frame>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>

    </Grid>
</ContentPage>